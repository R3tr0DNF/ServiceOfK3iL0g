<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <AssemblyName>MicrosoftWeatherService</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-KeyLoggerService-8dde7fd3-81ac-40c7-82fb-e20e58bb7fd0</UserSecretsId>
    <ServiceName>Microsoft Weather Service</ServiceName>
  </PropertyGroup>

  <ItemGroup>
